data/betting_model.db-wal

# Trained model binaries (large, regenerated via trainer.py)
models/saved/

# Raw data files (large CSVs — store separately)
data/raw/datawarehouse/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Logs (runtime output)
logs/

# Notebooks (scratch work)
notebooks/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Environment / secrets — never commit
.env
*.env

# SQLite database (rebuilt from source data)
data/betting_model.db
data/betting_model.db-shm
data/betting_model.db-wal

# Trained model binaries — current models committed to repo
# When retraining: delete the old .pkl, commit the new one

# Raw data files (large CSVs — store separately)
data/raw/datawarehouse/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Logs (runtime output)
logs/

# Notebooks (scratch work)
notebooks/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Local modelling cache — pulled from Supabase, regenerable in one command
# (scripts/pull_local_cache.py). Never committed: it is large and it must not
# be able to reach the worker, where a stale copy would score live picks.
data/local/

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Agent",
      "Skill",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "Monitor",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "CronCreate",
      "CronDelete",
      "CronList",
      "PushNotification",
      "SendMessage",
      "SendUserFile",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "EnterWorktree",
      "ExitWorktree",
      "ToolSearch",
      "Workflow",
      "mcp__Railway__*",
      "mcp__claude_ai_Railway__*",
      "mcp__github__*",
      "mcp__claude_ai_github__*",
      "mcp__Gmail__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__Google_Drive__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__Signalbase__*",
      "mcp__claude_ai_Signalbase__*",
      "mcp__Retool__*",
      "mcp__claude_ai_Retool__*",
      "mcp__Claude_Docs__*",
      "mcp__claude_ai_Claude_Docs__*",
      "mcp__memory__*",
      "mcp__claude_ai_memory__*",
      "mcp__claude-code-remote__*",
      "mcp__claude_ai_claude-code-remote__*",
      "mcp__Mobbin__*",
      "mcp__claude_ai_Mobbin__*",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__list_projects",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__list_migrations",
      "mcp__claude_ai_Supabase__list_extensions",
      "mcp__claude_ai_Supabase__get_advisors",
      "mcp__claude_ai_Supabase__query_logs",
      "mcp__claude_ai_Supabase__get_project",
      "mcp__claude_ai_Supabase__get_project_url",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__Supabase__search_docs",
      "mcp__Supabase__get_organization",
      "mcp__claude_ai_Supabase__search_docs",
      "mcp__claude_ai_Supabase__get_organization",
      "mcp__Supabase__execute_sql",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__Supabase__apply_migration",
      "mcp__claude_ai_Supabase__apply_migration",
      "mcp__Supabase__generate_typescript_types",
      "mcp__claude_ai_Supabase__generate_typescript_types",
      "mcp__Supabase__get_edge_function",
      "mcp__claude_ai_Supabase__get_edge_function",
      "mcp__Supabase__list_edge_functions",
      "mcp__claude_ai_Supabase__list_edge_functions",
      "mcp__Supabase__get_notebook",
      "mcp__claude_ai_Supabase__get_notebook",
      "mcp__Supabase__list_notebooks",
      "mcp__claude_ai_Supabase__list_notebooks",
      "mcp__Supabase__run_notebook",
      "mcp__claude_ai_Supabase__run_notebook",
      "mcp__Supabase__get_publishable_keys",
      "mcp__claude_ai_Supabase__get_publishable_keys",
      "mcp__Supabase__list_branches",
      "mcp__claude_ai_Supabase__list_branches"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/hooks/connector_reminder.json 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/outstanding.py\" --session-start 2>/dev/null || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/outstanding.py\" --refresh-cache >/dev/null 2>&1 || true",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*Supabase__(execute_sql|apply_migration)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/picks_read_only_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/league_models_writeback.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

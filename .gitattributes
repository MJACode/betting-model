# LightGBM model files are DATA, not text: autocrlf rewriting them to CRLF on
# checkout corrupts them for lightgbm's C parser (crashed the test suite the
# first time a rebase touched them). Never translate.
ncaaf_live/data/artifacts/* -text

# Inactive historical pkls may still exist as regular git blobs in history.
# New inactive pkls should not be added (see .gitignore). Active pkls remain
# normal git blobs so the Railway checkout can score without LFS.

# graphify outputs are machine-written JSON/HTML, rewritten whole by `graphify
# update .`. Never translate line endings or every checkout shows them modified.
graphify-out/** -text

# The Retool ops dashboard's source (retool/README.md). Retool stores it with LF
# endings and scripts/retool_app_files.py compares it byte for byte, so a
# checkout must never turn LF into CRLF (autocrlf=true on mike's machine).
retool/** text eol=lf

# ══════════════════════════════════════════════════════════════════════════════
# Betting Model — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── The Odds API ──────────────────────────────────────────────────────────────
# Get your key at https://the-odds-api.com
ODDS_API_KEY=your_key_here

# ── Paper Trading Bankroll ────────────────────────────────────────────────────
# Starting bankroll for paper trading simulation (dollars)
BANKROLL=1000

# ── Model Thresholds ─────────────────────────────────────────────────────────
# Minimum edge to surface a BET signal (decimal, e.g. 0.03 = 3%)
BET_EDGE_THRESHOLD=0.03

# Minimum edge magnitude to surface an AVOID signal (decimal)
AVOID_EDGE_THRESHOLD=0.03

# Max Kelly fraction per bet (hard cap, decimal — 0.05 = 5% of bankroll)
MAX_KELLY_FRACTION=0.05

# ── Early Season Rule ─────────────────────────────────────────────────────────
# Minimum games a team must have played before model generates picks
MIN_GAMES_BASELINE=10

# ── Return-from-Injury Ramp ───────────────────────────────────────────────────
# Weighting applied to returning player's stats contribution
# Games 1-2 post-IL activation
RETURN_RAMP_EARLY=0.70
# Games 3-5 post-IL activation
RETURN_RAMP_MID=0.85
# Games 6+ — treated as fully healthy
RETURN_RAMP_FULL=1.00

# ── Scheduling ────────────────────────────────────────────────────────────────
# Time to run daily pipeline (24hr format, local machine time)
PIPELINE_RUN_TIME=07:00

# ── Database ─────────────────────────────────────────────────────────────────
# Relative path from project root — do not change unless you move the DB
DB_PATH=data/betting_model.db

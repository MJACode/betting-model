# Never commit credentials. All API keys come from the environment:
#   THE_ODDS_API_KEY
.env
.env.*
*.key
secrets.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# nflverse play-by-play. ~120MB per season and free to refetch from
# https://github.com/nflverse/nflverse-data/releases
data/raw/

# Generated bet cards, poller logs and poller state. Outputs, not inputs.
# poll_state.json is what makes the wind poller fire once per game across a
# restart: machine-local runtime state, and syncing it would double-fire.
data/cards/*.csv
data/cards/poll_state.json

# OS noise
.DS_Store

# ERA5 + Open-Meteo cache. 108MB unpacked, free to refetch;
# scripts/validate_wind_forecast.py rebuilds it automatically.
data/weather_cache/

# nflverse play-by-play parquets: free to refetch from the nflverse GitHub
# releases, ~220MB. live_model/backtest/pull_pbp.py rebuilds them.
data/pbp/

# Reconstructed live model state series: ~180MB, rebuilt in about a
# minute by live_model/backtest/states.py from the pbp parquets.
data/live_model/states_all.parquet

# Reconstructed live-prop flow rows: ~230MB, rebuilt by
# live_model/backtest/flow_dataset.py from the pbp parquets.
data/live_model/flow_rows.parquet

# nflverse players file: free to refetch from the players release.
data/pbp/players.parquet
